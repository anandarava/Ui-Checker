{
  "$description": "Sample design tokens for the dashboard fixture: the scale of dashboard-clean.html. Made-up values, in the Design Tokens Community Group format.",
  "color": {
    "$type": "color",
    "brand": { "primary": { "$value": "#0b4a8f" }, "tint": { "$value": "#c7d7ea" } },
    "text": { "default": { "$value": "#111111" }, "muted": { "$value": "#6b6b6b" }, "icon": { "$value": "#333" } },
    "surface": { "card": { "$value": "#ffffff" }, "page": { "$value": "rgb(242, 242, 242)" } },
    "border": { "default": { "$value": "hsl(0, 0%, 86.3%)" } },
    "link": { "$value": "{color.brand.primary}" }
  },
  "space": {
    "$type": "dimension",
    "1": { "$value": "4px" },
    "2": { "$value": "8px" },
    "2-5": { "$value": "10px" },
    "3": { "$value": "12px" },
    "3-25": { "$value": "13px" },
    "3-5": { "$value": "14px" },
    "3-75": { "$value": "15px" },
    "4": { "$value": "1rem" },
    "5": { "$value": "20px" },
    "6": { "$value": "24px" },
    "6-25": { "$value": "25px" },
    "6-5": { "$value": "26px" },
    "7": { "$value": "28px" },
    "page-inset": { "$value": "35px" },
    "9": { "$value": "36px" }
  },
  "font": {
    "family": { "$type": "fontFamily", "base": { "$value": ["system-ui", "-apple-system", "Segoe UI", "Roboto", "sans-serif"] } },
    "size": {
      "$type": "dimension",
      "caption": { "$value": "12px" },
      "small": { "$value": "13px" },
      "button": { "$value": "14px" },
      "meta": { "$value": "15px" },
      "body": { "$value": "16px" },
      "value": { "$value": "17px" },
      "subtitle": { "$value": "20px" }
    },
    "weight": { "$type": "fontWeight", "regular": { "$value": 400 }, "semibold": { "$value": "SemiBold" }, "bold": { "$value": 700 } }
  },
  "typography": {
    "$type": "typography",
    "card-title": { "$value": { "fontFamily": "{font.family.base}", "fontSize": "22px", "fontWeight": "{font.weight.bold}", "lineHeight": 1.3 } },
    "page-title": { "$value": { "fontFamily": "{font.family.base}", "fontSize": "28px", "fontWeight": "{font.weight.regular}", "lineHeight": 1.3 } }
  },
  "radius": { "$type": "dimension", "card": { "$value": "12px" }, "control": { "$value": "6px" } }
}
